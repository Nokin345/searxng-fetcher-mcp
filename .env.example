# Your SearXNG instance URL
SEARXNG_URL=http://searxng:8080

# HTTP server settings
# MCP_HTTP_HOST is the *container* bind address; docker-proxy needs the
# container IP, so keep 0.0.0.0 here and restrict exposure in docker-compose.yml
# (the port mapping is 127.0.0.1:PORT). Compose maps MCP_HTTP_PORT to itself, so
# set it to the port you want on the host.
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Timeout settings (milliseconds)
FETCH_TIMEOUT_MS=10000
SEARCH_TIMEOUT_MS=10000

# URL reader settings
URL_READ_MAX_CONTENT_BYTES=5242880
URL_READER_USER_AGENT=searxng-fetcher-mcp/1.0
